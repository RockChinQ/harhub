PORT=3310
HARHUB_MAX_UPLOAD_BYTES=26214400
# Set to the exact number of reverse proxies in front of Harhub (for example 1).
# Leave false for direct exposure; do not trust arbitrary forwarded client IPs.
HARHUB_TRUST_PROXY=false
HARHUB_AUTH_RATE_LIMIT_WINDOW_MS=900000
HARHUB_AUTH_RATE_LIMIT_MAX=30
HARHUB_UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
HARHUB_UPLOAD_RATE_LIMIT_MAX=100
HARHUB_PUBLIC_SHARE_RATE_LIMIT_WINDOW_MS=60000
HARHUB_PUBLIC_SHARE_RATE_LIMIT_MAX=120

# Cloud-native state backend. Use Postgres-compatible hosted databases such as
# RDS, Cloud SQL, Neon, Supabase, or Crunchy Bridge.
HARHUB_DATABASE_URL=postgres://harhub:harhub@127.0.0.1:15432/harhub
# Set to "true" when the hosted database requires TLS and the provider manages
# the certificate chain.
HARHUB_DATABASE_SSL=false

# S3-compatible object storage for uploaded Skill zip packages.
HARHUB_S3_BUCKET=harhub-assets
HARHUB_S3_REGION=us-east-1
HARHUB_S3_ENDPOINT=http://127.0.0.1:9000
HARHUB_S3_FORCE_PATH_STYLE=true
HARHUB_S3_PREFIX=dev
HARHUB_S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/harhub-assets
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Public app URL used to build OAuth callback URLs and workspace invite links.
HARHUB_PUBLIC_URL=http://127.0.0.1:5176

# Password sign-in. New email addresses automatically create an account and workspace.
HARHUB_PASSWORD_LOGIN_ENABLED=true

# Email login codes and workspace invitation emails.
RESEND_API_KEY=
HARHUB_EMAIL_FROM=Harhub <onboarding@resend.dev>

# Optional OAuth providers. Callback URLs:
#   http://127.0.0.1:3310/api/auth/oauth/google/callback
#   http://127.0.0.1:3310/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App for importing and continuously observing existing repositories.
# Setup URL and OAuth callback:
#   https://harhub.example.com/api/github/installations/callback
# Webhook URL:
#   https://harhub.example.com/api/github/webhooks
HARHUB_GITHUB_APP_ID=
HARHUB_GITHUB_APP_SLUG=
HARHUB_GITHUB_APP_CLIENT_ID=
HARHUB_GITHUB_APP_CLIENT_SECRET=
# PEM text with escaped newlines, or the PEM encoded as base64.
HARHUB_GITHUB_APP_PRIVATE_KEY=
HARHUB_GITHUB_WEBHOOK_SECRET=

# Stable server-side key used to encrypt workspace-scoped credentials such as
# Forge AI API keys. Set this in hosted and multi-instance deployments.
HARHUB_ENCRYPTION_KEY=
